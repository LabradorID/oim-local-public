# Local environment overrides
.env
.env.local
*.local

# Backups
backups/
*.bak

# Exported SQL Server state (large; rebuilt via `make export-state`)
mssql-state/

# Logs
*.log
logs/

# OIM build/diagnostic artifacts
*.sdf
*.diagsession

# Editor/IDE
.vscode/
.idea/
.claude/

# OS junk
.DS_Store
Thumbs.db

# --- Secrets ---
# Local-dev secret files in secrets/ are committed (placeholder values, not
# real credentials). The only thing that must NOT be committed is the actual
# session certificate.
secrets/**/SessionCertificate.pfx
