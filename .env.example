# Copy this file to .env and adjust values for your environment.
# .env is git-ignored.

# --- MSSQL ---
# Must satisfy SQL Server's password complexity rules.
MSSQL_SA_PASSWORD=ChangeMe_Strong1

# Active OneIM database image tag in the local registry. `make rollback TAG=...`
# rewrites this line. See the "Failsafe development" section in README.md.
MSSQL_IMAGE_TAG=v01

# --- One Identity Manager database ---
# These are the database name and admin/config/user accounts you will create
# during the OIM Configuration Wizard. Mirror them here so the helper targets
# (connection-info, etc.) display correct values.
OIM_DATABASE_NAME=OneIM
OIM_DATABASE_USER=OneIM_Admin
OIM_DATABASE_PASSWORD=ChangeMe_Admin1

# --- Host IP ---
# IP at which the host is reachable from clients (e.g. WSL host IP for Windows
# clients connecting to SSMS / browser). `hostname -I` usually shows it.
HOST_IP=127.0.0.1

# --- API Server / Portal ---
OIM_APPLICATION_TOKEN=oim-dev-token
OIM_DIALOG_USER=viadmin
OIM_DIALOG_PASSWORD=ChangeMe_System1

# --- Job Server web UI ---
JOBSERVER_HTTP_USER=admin
JOBSERVER_HTTP_PWD=ChangeMe_Jobs1

# --- SCIM server (optional dataservices) ---
SCIM_BEARER_TOKEN=scim-dev-token

# --- LDAP servers (optional dataservices) ---
LDAP_ADMIN_PASSWORD=ChangeMe_Ldap1
